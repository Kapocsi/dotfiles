function _on_change_pwd() {
    # (de)activate the venv belonging to the project we're now in
    local root=$(git rev-parse --show-toplevel 2>/dev/null)
    local dir

    if [[ -n $root ]]; then
        dir=$root
    else
        # not a repo: walk up from $PWD looking for a .venv
        dir=$PWD
        while [[ ! -d $dir/.venv && $dir != / ]]; do
            dir=${dir:h}
        done
    fi

    if [[ -d $dir/.venv ]]; then
        # already in this project's venv, nothing to do
        [[ $VIRTUAL_ENV == $dir/.venv ]] && return
        source $dir/.venv/bin/activate
    elif [[ -n $VIRTUAL_ENV ]] && (( $+functions[deactivate] )); then
        deactivate
    fi
}
