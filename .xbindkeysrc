"playerctl play-pause"
    XF86AudioPlay

# Cause my headphones alternate better play and pause
"playerctl pause"
    XF86AudioPause

"playerctl next"
    XF86AudioNext

"playerctl previous"
    XF86AudioPrev


"ddcutil --display 1 setvcp 60 6"
    mod4 + insert

"ddcutil --display 1 setvcp 60 9"
    mod4 + home
